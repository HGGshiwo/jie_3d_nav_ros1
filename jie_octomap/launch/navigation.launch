<launch>
    <!-- 局部地图使用的点云话题 -->
    <arg name="point_cloud_topic" default="/lidar_points" />
    
    <!-- 全局 3D Octomap 地图获取方式配置：
         1. global_octomap_path 不为空时，启动 map_package_manager 加载离线地图包
         2. global_octomap_path 为空时，启动 occupancy_grid_to_octomap 将 2D 地图转换发布 -->
    <arg name="global_octomap_path" default="/home/hggshiwo/catkin_3dnavi/map-segment/" />
    <arg name="map_topic" default="/map" />
    <arg name="use_rviz" default="true" />

    <!-- 设置为 true 时，网页上手动设置起点会自动广播 map -> base_footprint 的伪 TF 变换（用于无定位硬件调试） -->
    <arg name="publish_fake_tf" default="true" />

    <!-- 1. 全局地图生成节点 (按参数条件分发) -->
    <!-- Case A: 载入预构建的离线 Octomap 包 -->
    <node unless="$(eval arg('global_octomap_path') == '')" pkg="jie_octomap" type="map_package_manager.py" name="global_map_package_manager" output="screen">
        <param name="autoload_package_path" value="$(arg global_octomap_path)" />
        <param name="octomap_topic" value="/octomap_global" />
        <param name="occupied_marker_topic" value="/octomap_global_markers" />
    </node>

    <!-- Case B: 无静态包时，自动将 2D 栅格地图转换为 3D 全局 Octomap -->
    <node if="$(eval arg('global_octomap_path') == '')" pkg="jie_octomap" type="occupancy_grid_to_octomap_node" name="occupancy_grid_to_octomap" output="screen">
        <param name="grid_topic" value="$(arg map_topic)" />
        <param name="octomap_topic" value="/octomap_global" />
        <param name="frame_id" value="map" />
        <param name="octomap_resolution" value="0.2" />
        <param name="wall_height_m" value="1.0" />
        <param name="floor_z_m" value="0.0" />
        <param name="occupied_threshold" value="50" />
    </node>

    <!-- 2. 局部动态点云 Octomap 生成节点 -->
    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
        <param name="resolution" value="0.10" />
        <param name="frame_id" type="string" value="map" />
        <param name="sensor_model/max_range" value="5.0" />
        <param name="filter_ground" value="true" />
        <remap from="cloud_in" to="$(arg point_cloud_topic)" />
        <remap from="octomap_binary" to="/octomap_local" />
    </node>

    <!-- 3. 包含纯粹的 move_base 导航规划节点 -->
    <include file="$(find jie_octomap)/launch/move_base.launch">
        <arg name="point_cloud_topic" value="$(arg point_cloud_topic)"/>
        <arg name="global_octomap_topic" value="/octomap_global"/>
    </include>

    <!-- 4. 辅助节点：TF 广播、Marker 转换、Web 服务器与 RViz -->
    <node pkg="jie_octomap" type="octomap_to_occupied_markers_node" name="global_octomap_markers" output="screen">
        <param name="octomap_topic" value="/octomap_global" />
        <param name="marker_topic" value="/octomap_global_markers" />
    </node>

    <node if="$(arg use_rviz)" pkg="jie_octomap" type="octomap_to_occupied_markers_node" name="local_octomap_markers" output="screen">
        <param name="octomap_topic" value="/octomap_local" />
        <param name="marker_topic" value="/octomap_local_markers" />
    </node>

    <!-- Map Viewer Web Server (FastAPI) -->
    <node pkg="jie_octomap" type="map_viewer_server" name="map_viewer_server" output="screen">
        <param name="occupied_marker_topic" value="/octomap_global_markers" />
        <param name="traversable_marker_topic" value="/move_base/traversable_cells" />
        <param name="preblocked_marker_topic" value="/move_base/preblocked_cells" />
        <param name="risk_cost_topic" value="/move_base/risk_cost_cloud" />
        <param name="path_topic" value="/move_base/plan" />
        <param name="odom_topic" value="/loc_base" />
        <param name="publish_fake_tf" value="$(arg publish_fake_tf)" />
    </node>

    <!-- RViz 可视化界面 -->
    <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find jie_octomap)/config/rviz/go2.rviz" required="true" />

    <!-- 用于获取调试节点的  -->
    <node pkg="octo_planner" type="jie_path_node" name="jie_path_node" output="screen">
        <param name="octomap_topic" value="/octomap_global"/>
    </node>
</launch>