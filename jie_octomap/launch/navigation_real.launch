<launch>
    <include file="$(find jie_octomap)/launch/navigation.launch">
        <arg name="use_rviz" value="false" />
        <!-- <arg name="global_octomap_path" value="/home/unitree/catkin_ws2/src/map-segment" /> -->
        <arg name="global_octomap_path" value="/home/unitree/catkin_ws2/src/map-segmentpatch" />
        <!-- <arg name="global_octomap_path" value="/home/unitree/catkin_ws2/src/map-segment0.05" /> -->
        <arg name="sim" value="false" />
    </include>
    
    <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_to_hesai_broadcaster"
          args="0 0 0 0 0 0 lidar hesai_lidar" required="true" />
    <node pkg="tf" type="static_transform_publisher" name="footprint_broadcaster" args="0 0 0 0 0 0 base_link base_footprint 10" launch-prefix="taskset -c 2"/>
</launch>